# Copia este fichero a .env y ajústalo.
# IP donde escucha el contenedor: 127.0.0.1 (solo este equipo), la de tu red local o la de Tailscale.
BIND_IP=127.0.0.1
PORT=48213
# Carpeta con tus podcasts: una subcarpeta por serie con sus audios dentro.
PODCAST_DIR=/ruta/a/tus/podcasts
# Hosts aceptados (IP:puerto con el que abres la web). Vacío = cualquiera.
# El de 127.0.0.1 hace falta para el healthcheck del contenedor.
ALLOWED_HOSTS=127.0.0.1:48213
# on = pedir usuario y contraseña
AUTH=off
